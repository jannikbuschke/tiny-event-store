<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Authors>Jannik Buschke</Authors>
        <IncludeSymbols>true</IncludeSymbols>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageId>TinyEventStore.Ef</PackageId>
        <RootNamespace>TinyEventStore.Ef</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <Title>TinyEventStore.Ef</Title>
        <Description>TinyEventStore does the thing!</Description>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <Optimize>true</Optimize>
        <Tailcalls>true</Tailcalls>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Core.fs" />
        <Compile Include="Json.fs" />
        <Compile Include="Storables.fs" />
        <Compile Include="ConfigureDbContext.fs" />
        <Compile Include="Queries.fs" />
        <Compile Include="Handler.fs" />
        <Compile Include="Projections.fs" />
        <Compile Include="EfStore.fs" />
        <Compile Include="EfStorage/dtos.fs"/>
        <Compile Include="EfStorage/SimpleDtos.fs"/>
        <Compile Include="EfStorage/EfStorage.fs"/>
        <Compile Include="EfStorage/EfSimpleStorage.fs"/>
        <Compile Include="EfStorage/Projections.fs"/>
        <Compile Include="EfStorage/SimpleProjections.fs"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.*"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TinyEventStore\TinyEventStore.fsproj"/>
    </ItemGroup>

</Project>
